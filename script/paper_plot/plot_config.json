{
  "figure.figsize": [3.5, 2],
  "figure.dpi": 96,
  "figure.constrained_layout.use": false,
  "savefig.dpi": 96,
  "savefig.bbox": null,
  "svg.fonttype": "none",
  "text.usetex": true,
  "text.latex.preamble": "\\usepackage{lmodern}",
           
  "font.family": "serif",
  "font.serif": ["Latin Modern Roman", "Times New Roman"],
  "mathtext.fontset": "cm",
  "font.size": 8,
  "figure.labelsize": 8,

  "axes.titlesize": 8,              
  "axes.labelsize": 8,              
  "axes.linewidth": 0.35, 
  "axes.labelpad": 3.0,            
  "axes.grid": true,                 
  "grid.alpha": 0.3,
  "grid.linewidth": 0.35,
  "grid.linestyle": "-",
  
  "xtick.top": true,
  "xtick.bottom": true,
  "xtick.major.size": 1.5,
  "xtick.major.width": 0.35,
  "xtick.minor.size": 0.75,
  "xtick.minor.width": 0.35,
  "ytick.left": true,
  "ytick.right": true,
  "ytick.major.size": 1.5,
  "ytick.major.width": 0.35,
  "ytick.minor.size": 0.75,
  "ytick.minor.width": 0.35,

  "lines.linewidth": 0.75,
  "lines.markersize": 3.3,
  "lines.markeredgewidth": 0.35,

  "legend.frameon": false,
  "legend.framealpha": 0.8,
  "legend.borderaxespad": 0.0,
  "legend.borderpad": 0.4,
  "legend.handletextpad": 0.8,
  "legend.labelspacing": 0.5,
  "legend.columnspacing": 2.0,

  "palettes": {
    "wong": ["#000000", "#E69F00", "#56B4E9", "#009E73",
             "#F0E442", "#0072B2", "#D55E00"],
    "nature": ["#E64B35", "#4DBBD5", "#00A087", "#3C5488",
               "#F39B7F", "#8491B4", "#91D1C2", "#DC0000", "#7E6148", "#B09C85"]
  }
}
